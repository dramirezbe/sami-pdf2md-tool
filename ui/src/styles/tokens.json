{
  "meta": {
    "name": "SAMI Design Tokens",
    "version": "1.0.0",
    "description": "Color palette, typography, spacing and elevation tokens for SAMI — Smart Automated Markdown Interpreter"
  },

  "color": {
    "brand": {
      "primary":       "#7B6DAF",
      "primary-hover":  "#6A5D98",
      "primary-active": "#5C5087",
      "primary-subtle": "rgba(123, 109, 175, 0.08)",
      "on-primary":     "#FFFFFF"
    },

    "light": {
      "bg-window":      "#F0F0F0",
      "bg-surface":     "#FFFFFF",
      "bg-raised":      "#FAFAFA",
      "bg-inset":       "#F5F5F5",
      "border":         "#E5E5E5",
      "border-subtle":  "#F0F0F0",
      "text-primary":   "#1A1A1A",
      "text-secondary": "#777777",
      "text-tertiary":  "#999999",
      "text-disabled":  "#BBBBBB"
    },

    "dark": {
      "bg-window":      "#1A1A1A",
      "bg-surface":     "#1E1E1E",
      "bg-raised":      "#252525",
      "bg-inset":       "#2A2A2A",
      "border":         "#333333",
      "border-subtle":  "#2A2A2A",
      "text-primary":   "#E0E0E0",
      "text-secondary": "#999999",
      "text-tertiary":  "#777777",
      "text-disabled":  "#555555",
      "accent":         "#9B8DC8"
    },

    "semantic": {
      "success":          "#62C554",
      "success-subtle":   "rgba(98, 197, 84, 0.08)",
      "warning":          "#E5A63B",
      "warning-subtle":   "rgba(229, 166, 59, 0.08)",
      "error":            "#E24B4A",
      "error-subtle":     "rgba(226, 75, 74, 0.08)",
      "info":             "#4A9FD9",
      "info-subtle":      "rgba(74, 159, 217, 0.08)",
      "pdf-red":          "#E24B4A"
    },

    "icon": {
      "base":           "#7B6DAF",
      "fold-shadow":    "#6A5D98",
      "fold-face":      "#9B8DC8",
      "m-glyph":        "#FFFFFF",
      "sheet":          "rgba(255, 255, 255, 0.15)",
      "fold-detail":    "rgba(255, 255, 255, 0.08)"
    }
  },

  "typography": {
    "font-family": {
      "body":     "'Inter', system-ui, -apple-system, sans-serif",
      "heading":  "'Space Grotesk', 'Inter', system-ui, sans-serif",
      "mono":     "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace"
    },
    "font-size": {
      "xs":    "11px",
      "sm":    "12px",
      "base":  "13px",
      "md":    "14px",
      "lg":    "15px",
      "xl":    "16px",
      "2xl":   "18px",
      "3xl":   "24px"
    },
    "font-weight": {
      "regular":   400,
      "medium":    500,
      "semibold":  600,
      "bold":      700
    },
    "line-height": {
      "tight":   1.3,
      "normal":  1.5,
      "relaxed": 1.7
    },
    "google-fonts-url": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
  },

  "spacing": {
    "xs":   "4px",
    "sm":   "8px",
    "md":   "10px",
    "base": "16px",
    "lg":   "24px",
    "xl":   "32px",
    "2xl":  "48px"
  },

  "radius": {
    "sm":   "4px",
    "base": "6px",
    "md":   "8px",
    "lg":   "10px",
    "icon": "28px"
  },

  "elevation": {
    "light": {
      "sm":  "0 1px 2px rgba(0,0,0,0.06)",
      "md":  "0 2px 8px rgba(0,0,0,0.08)",
      "lg":  "0 4px 16px rgba(0,0,0,0.1)"
    },
    "dark": {
      "sm":  "0 1px 2px rgba(0,0,0,0.2)",
      "md":  "0 2px 8px rgba(0,0,0,0.3)",
      "lg":  "0 4px 16px rgba(0,0,0,0.4)"
    }
  },

  "components": {
    "window-chrome": {
      "height": "36px",
      "traffic-lights": ["#EC6A5E", "#F5BF4F", "#62C554"]
    },
    "toolbar": {
      "height": "48px"
    },
    "button": {
      "height-sm": "28px",
      "height-md": "32px",
      "height-lg": "36px",
      "padding-x": "14px",
      "radius": "6px"
    },
    "file-row": {
      "height": "40px",
      "padding-x": "16px"
    },
    "progress-bar": {
      "height-sm": "6px",
      "height-lg": "8px",
      "radius": "4px"
    },
    "sidebar": {
      "width": "300px"
    },
    "preview-label": {
      "height": "32px",
      "text-transform": "uppercase",
      "letter-spacing": "0.5px"
    }
  }
}
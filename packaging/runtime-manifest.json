    "cpu_index_url": "https://download.pytorch.org/whl/cpu"
  },
  "marker": {
    "package": "marker-pdf",
    "version": "2.0.0",
    "note": "Pinned. Do not upgrade silently."
  },
  "modes": {
    "fast": {
      "engine": "fast",
      "inference_server": false,
      "gpu_required": false
    },
    "balanced": {
      "engine": "marker",
      "inference_server": false,
      "gpu_required": false,
      "marker_mode": "fast"
    },
    "quality": {
      "engine": "marker",
      "inference_server": true,
      "gpu_required": false,
      "marker_mode": "balanced",
      "note": "inference_server=true means llama-server is used. gpu_required=false: works on CPU with -ngl 0."
    }
  },
